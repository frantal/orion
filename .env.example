# ============================================================
# ORION — Environment configuration (EXAMPLE)
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env`. NEVER put secrets in source.
# ============================================================

# --- Alpaca (Paper Trading ONLY) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# SAFETY: keep this true. ORION refuses to run against live money.
ALPACA_PAPER_TRADE=true
# Route trading/account operations through the official Alpaca CLI (satisfies the
# hackathon MCP/CLI requirement). Requires the `alpaca` binary (see docs/MCP.md).
USE_ALPACA_CLI=false
# Optional explicit path to the alpaca binary (default: tools/alpaca[.exe] or PATH).
ALPACA_CLI_PATH=

# --- LLM (optional; used only for reasoning/explanation) ---
# Leave empty to run ORION fully deterministic (no generative layer).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# OpenAI-compatible endpoint (works with OpenAI, OpenRouter, Together, local, …)
LLM_BASE_URL=https://api.openai.com/v1

# --- Runtime ---
# DEMO_MODE=true uses a controlled dataset and never touches live market/orders.
DEMO_MODE=true
# USE_DEMO_DATA=true runs ORION fully offline (synthetic market, no Alpaca/keys needed).
USE_DEMO_DATA=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///data/orion.db
